# Copy to .env (gitignored). Non-secret settings only. AWS keys live in ~/.aws via `aws configure --profile finops-poc`.
AWS_PROFILE=finops-poc
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_FAST=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_STRONG=global.anthropic.claude-sonnet-4-6
# Optional, only for an approved one-off comparison:
BEDROCK_MODEL_OPUS=
# Spending guard: new Bedrock calls are refused at this cumulative total (USD). Override only with approval.
FINOPS_COST_CAP_USD=25
FINOPS_COST_OVERRIDE=0
# Demo monorepo that receives fix pull requests (the only repo the app may push to).
DEMO_REPO=Harisri-Sanjivan-S/acme-platform
# Code-fix executor: template (deterministic) or devin (Devin CLI, headless).
FINOPS_FIXER=template
DEVIN_BIN=/Applications/Devin.app/Contents/Resources/app/extensions/windsurf/devin/bin/devin
DEVIN_MODEL=
