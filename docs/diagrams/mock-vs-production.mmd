        R6["Jira / ServiceNow<br/>change-request API"]
        R7["AWS Budgets<br/>DescribeBudgets"]
        R8["Amazon DynamoDB<br/>exceptions table (owner, reason, expiry)"]
        R9["CI/CD deployment records + Git commits;<br/>VPC Flow Logs in S3 + Athena"]
        R10["Next day's CUR 2.0 lines,<br/>checked by an EventBridge schedule"]
    end

