        P4["metrics.json<br/>21 hourly CPU / GPU / NAT series"]
        P5["tags.json<br/>49 resources, GPUs untagged"]
        P6["tickets.json<br/>CHG-1042 load test"]
        P7["budgets.json<br/>3 cost budgets"]
